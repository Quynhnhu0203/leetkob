{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run format:check)",
      "Bash(npm run format)",
      "Bash(npm run typecheck)",
      "Bash(npm test)",
      "Bash(npm run test:contract)",
      "Bash(npm run check)",
      "Bash(npm ci)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git switch:*)",
      "Bash(git add:*)",
      "Edit(src/**)",
      "Edit(docs/**)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git tag:*)",
      "Bash(npm install:*)",
      "Bash(npm uninstall:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Edit(test/**)",
      "Edit(docs/contract/**)",
      "Edit(.github/**)",
      "Edit(CLAUDE.md)",
      "Edit(package.json)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Edit(.env)",
      "Edit(eval/**)",
      "Bash(cat .env*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main)",
      "Bash(git reset --hard:*)",
      "Bash(gh api -X DELETE:*)",
      "Bash(gh api --method DELETE:*)",
      "Bash(gh repo delete:*)",
      "Bash(docker run:*)"
    ]
  }
}
