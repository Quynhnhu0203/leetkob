# Hardened sandbox image for compiling and executing student C++ code
FROM alpine:3.20

# Install g++ compiler and standard C++ libraries
RUN apk add --no-cache g++ libstdc++

# Create non-root user 'sandbox' with UID 1000
RUN adduser -D -u 1000 sandbox

USER sandbox
WORKDIR /home/sandbox

CMD ["/bin/sh"]

