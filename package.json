{
  "name": "leetkob",
  "version": "0.1.0",
  "description": "LeeTKOB — constraint review for C++ lab submissions (CSC13114 PA#2)",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/unit",
    "test:contract": "vitest run test/contract",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run test:contract"
  },
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "fastify": "^5.12.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.7"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
