# Standalone container for running the LeeTKOB constraint checker
FROM node:22-alpine

WORKDIR /app

COPY package*.json tsconfig.json tsconfig.build.json ./
RUN npm ci

COPY src/ ./src/
RUN npm run build && npm prune --omit=dev

USER node

ENTRYPOINT ["node", "dist/checker-cli.js"]
CMD ["--data", "/data", "--output", "/out/predictions.jsonl"]
