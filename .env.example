# Copy to .env and fill in locally. Never commit .env.
# HTTP port of the API server
PORT=
# Google Gemini API key (free tier; see README "Model")
GEMINI_API_KEY=
# Gemini model id used by the constraint checker
GEMINI_MODEL=
# Hard cap on model calls per lab, enforced by the app (PA#3)
LLM_MAX_CALLS_PER_LAB=
